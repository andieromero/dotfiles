#!/usr/bin/env python3
"""
aerospace-tile-gap — adjust the AeroSpace `outer.top` value for the focused
monitor. Used by the SketchyBar +/- pills next to the workspace divider so
the user can dial in the right tile-vs-bar gap on any attached display
without editing the toml or restarting AeroSpace.

Usage:
  aerospace-tile-gap +N        # bump up by N px (default N=1 if just '+')
  aerospace-tile-gap -N        # bump down by N px
  aerospace-tile-gap =N        # set exact value
  aerospace-tile-gap --show    # print current value, no mutation

Behavior:
  - Determines the focused monitor via `aerospace list-monitors --focused`.
  - If the monitor name starts with "Built-in" → mutates the
    `monitor."built-in"` rule. Otherwise → mutates the bare-integer fallback
    at the end of the outer.top list (which covers all externals).
  - Writes aerospace.toml atomically (temp + rename) under a flock so
    concurrent invocations don't race.
  - Schedules a debounced `aerospace reload-config` 200ms after the last
    invocation. Burst clicks coalesce into one reload at the end — pill
    label updates immediately on each click, but tiles only reposition once
    the burst settles.

Clamps to 0..200 px.
"""

from __future__ import annotations
import argparse
import fcntl
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time
from pathlib import Path

CONFIG = Path(os.environ.get("AEROSPACE_CONFIG", os.path.expanduser("~/.config/aerospace/aerospace.toml")))
LOCK = Path("/tmp/aerospace-tile-gap.lock")
RELOAD_PID = Path("/tmp/aerospace-tile-gap.reload.pid")
DEBOUNCE_SEC = 0.2
MIN_GAP = 0
MAX_GAP = 200


def focused_monitor_name() -> str:
    """Return the focused monitor name, falling back through three strategies.

    AeroSpace can report a phantom focused monitor with an empty name in some
    states (post-hotplug, stale daemon). Try in order:
      1. list-monitors --focused (cleanest)
      2. list-windows --focused (monitor of the focused window)
      3. first non-empty named monitor (least specific, but always works)
    """
    for cmd in (
        ["aerospace", "list-monitors", "--focused", "--format", "%{monitor-name}"],
        ["aerospace", "list-windows", "--focused", "--format", "%{monitor-name}"],
    ):
        r = subprocess.run(cmd, capture_output=True, text=True, check=False)
        for line in r.stdout.strip().splitlines():
            line = line.strip()
            if line:
                return line
    # Last resort: first named monitor in the full list
    r = subprocess.run(
        ["aerospace", "list-monitors", "--format", "%{monitor-name}"],
        capture_output=True, text=True, check=False,
    )
    for line in r.stdout.strip().splitlines():
        line = line.strip()
        if line:
            return line
    return ""


def is_builtin(monitor_name: str) -> bool:
    return monitor_name.lower().startswith("built-in")


def parse_action(action: str, current: int) -> int:
    if action.startswith("="):
        return int(action[1:])
    if action.startswith("+"):
        delta = int(action[1:]) if len(action) > 1 else 1
        return current + delta
    if action.startswith("-"):
        delta = int(action[1:]) if len(action) > 1 else 1
        return current - delta
    return int(action)


def find_block(text: str) -> tuple[int, int]:
    """Return (start, end) byte offsets of the inner content of outer.top = [...]."""
    m = re.search(r"outer\.top\s*=\s*\[\n(.*?)\n\]", text, re.DOTALL)
    if not m:
        sys.exit("aerospace-tile-gap: couldn't find outer.top block in aerospace.toml")
    return m.start(1), m.end(1)


def read_current(text: str, builtin: bool) -> int:
    s, e = find_block(text)
    block = text[s:e]
    if builtin:
        m = re.search(r'monitor\."built-in"\s*=\s*(\d+)', block)
    else:
        m = re.search(r"^\s*(\d+)\s*$", block, re.MULTILINE)
    return int(m.group(1)) if m else 0


def rewrite(text: str, builtin: bool, new: int) -> str:
    s, e = find_block(text)
    block = text[s:e]
    if builtin:
        new_block, n = re.subn(
            r'(monitor\."built-in"\s*=\s*)\d+',
            rf"\g<1>{new}",
            block,
            count=1,
        )
    else:
        new_block, n = re.subn(
            r"^(\s*)\d+(\s*)$",
            rf"\g<1>{new}\g<2>",
            block,
            count=1,
            flags=re.MULTILINE,
        )
    if n != 1:
        sys.exit(f"aerospace-tile-gap: failed to find {'built-in' if builtin else 'fallback'} entry to mutate")
    return text[:s] + new_block + text[e:]


def schedule_debounced_reload() -> None:
    # Cancel any pending reload from a prior click in this burst.
    if RELOAD_PID.exists():
        try:
            old_pid = int(RELOAD_PID.read_text().strip())
            os.kill(old_pid, signal.SIGTERM)
        except (ValueError, ProcessLookupError, PermissionError):
            pass

    # Spawn a detached child that sleeps and then reloads. Double-fork so
    # the child outlives this process even after the lockfile is released.
    if os.fork() == 0:
        # Detach from parent
        os.setsid()
        if os.fork() == 0:
            try:
                RELOAD_PID.write_text(str(os.getpid()))
                time.sleep(DEBOUNCE_SEC)
                subprocess.run(
                    ["aerospace", "reload-config"],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False,
                )
            finally:
                try:
                    RELOAD_PID.unlink(missing_ok=True)
                except OSError:
                    pass
            os._exit(0)
        os._exit(0)


def main() -> None:
    parser = argparse.ArgumentParser(description="Adjust AeroSpace outer.top for the focused monitor.")
    parser.add_argument("--show", action="store_true", help="Print current value, no mutation")
    parser.add_argument("action", nargs="?", default=None, help="+N, -N, or =N")
    args = parser.parse_args()

    if not args.show and not args.action:
        parser.error("provide an action (+N | -N | =N) or --show")

    monitor = focused_monitor_name()
    if not monitor:
        sys.exit("aerospace-tile-gap: no focused monitor (is AeroSpace running?)")
    builtin = is_builtin(monitor)

    if args.show:
        text = CONFIG.read_text()
        print(read_current(text, builtin))
        return

    LOCK.touch(exist_ok=True)
    with open(LOCK, "r+") as lockf:
        fcntl.flock(lockf, fcntl.LOCK_EX)

        text = CONFIG.read_text()
        current = read_current(text, builtin)
        new = max(MIN_GAP, min(MAX_GAP, parse_action(args.action, current)))

        if new == current:
            print(current)
            return

        new_text = rewrite(text, builtin, new)

        # Atomic write: temp + rename
        with tempfile.NamedTemporaryFile("w", dir=str(CONFIG.parent), delete=False) as tmp:
            tmp.write(new_text)
            tmp_path = Path(tmp.name)
        shutil.copymode(CONFIG, tmp_path)
        tmp_path.replace(CONFIG)

        schedule_debounced_reload()
        print(new)


if __name__ == "__main__":
    main()
