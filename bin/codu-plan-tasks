#!/usr/bin/env bash
# codu-plan-tasks: show open tasks for a plan. Used as fzf --preview command.
#
# Usage: codu-plan-tasks "!! plan-name  43%"

set -euo pipefail

INPUT="${1:-}"
[ -z "$INPUT" ] && exit 0

# Handle skip option
case "$INPUT" in
  *"no plan"*|*"no ave"*|*"keep"*) echo ""; echo "  start a blank session"; exit 0 ;;
esac

# Extract plan name: "!! plan-name  43%" → "plan-name"
PLAN=$(echo "$INPUT" | sed 's/^[! ]*//' | awk '{print $1}')
[ -z "$PLAN" ] && exit 0

BRAIN="${FLOWEN_BRAIN:-$HOME/Flowen/twin-andie}"

# Find the plan file
PLAN_FILE=""
for f in "$BRAIN/experiences/plans/${PLAN}-plan.md" "$BRAIN/experiences/plans"/*/"${PLAN}-plan.md"; do
  [ -f "$f" ] && PLAN_FILE="$f" && break
done
[ -z "$PLAN_FILE" ] && echo "  plan not found: $PLAN" && exit 0

# Extract plan title — strip markdown
title=$(grep -m1 "^#" "$PLAN_FILE" | sed 's/^#* *//;s/^Plan: *//' | head -c 50)

# Progress
done_count=$(grep -c '\- \[x\]' "$PLAN_FILE" 2>/dev/null || echo 0)
open_count=$(grep -c '\- \[ \]' "$PLAN_FILE" 2>/dev/null || echo 0)
total=$((done_count + open_count))
pct=0
[ "$total" -gt 0 ] && pct=$((done_count * 100 / total))

# Priority
priority=$(sed -n 's/^priority: *\(.*\)/\1/p' "$PLAN_FILE" | head -1)

# Progress bar
bar_w=24
bar_fill=$((pct * bar_w / 100))
bar_empty=$((bar_w - bar_fill))
bar=$(printf '%*s' "$bar_fill" '' | tr ' ' '█')$(printf '%*s' "$bar_empty" '' | tr ' ' '░')

# Render
echo ""
echo "  $title"
echo ""
echo "  $bar  ${pct}%  (${done_count}/${total})"
[ -n "$priority" ] && echo "  priority: $priority"
echo ""
echo "  ─── open tasks ──────────────────────────"
echo ""

# Show open tasks — strip markdown formatting
grep '\- \[ \]' "$PLAN_FILE" 2>/dev/null | head -12 | while IFS= read -r line; do
  task=$(echo "$line" \
    | sed 's/^[[:space:]]*- \[ \] *//' \
    | sed 's/\*\*//g' \
    | sed 's/`//g' \
    | sed 's/\[//g;s/\]//g' \
    | head -c 48)
  echo "  · $task"
done

if [ "$open_count" -gt 12 ]; then
  remaining=$((open_count - 12))
  echo ""
  echo "  +${remaining} more tasks"
fi

echo ""
echo "  ─── done ────────────────────────────────"
echo "  ${done_count} tasks completed"
