#!/usr/bin/env bash
# codu-start <issue-number> [<repo>]
#
# Kicks off a codu builder session bound to a GitHub issue. Mirror of
# claude-start, adapted for codu builder's tool model:
#   - codu builder controls allowed tools via ~/.flowen/agent.toml (not per-call flags)
#   - so codu-start is mostly a context-loader + tmux orchestrator
#
# Usage:
#   codu-start 128                    # current repo
#   codu-start 128 Flowen-AI/flowen-os  # explicit repo
#
# Behavior:
#   1. Fetches issue title + body via `gh issue view`
#   2. Creates a named tmux session `issue-<N>`
#   3. Launches `flowen repl` (codu builder) inside it
#   4. After ~2s settle, pipes the issue context as the first prompt
#   5. Attaches you to the session
#
# The first-prompt content is templated for issue-driven dev work — feel free
# to edit the heredoc to match your typical kickoff style.

set -euo pipefail

issue="${1:?usage: codu-start <issue-number> [<repo>]}"
repo="${2:-}"

if ! command -v gh >/dev/null 2>&1; then
  echo "codu-start: gh CLI not found (brew install gh)" >&2
  exit 1
fi
if ! command -v flowen >/dev/null 2>&1; then
  echo "codu-start: flowen CLI not found — falling back to raw opencode" >&2
  LAUNCHER="opencode --agent flowen"
else
  LAUNCHER="flowen repl"
fi
TMUX_BIN="${TMUX_BIN:-$(command -v tmux 2>/dev/null || echo /opt/homebrew/bin/tmux)}"

# Fetch issue context. --repo flag is empty when $repo is unset (gh uses cwd remote).
GH_ARGS=("issue" "view" "$issue" "--json" "title,body,url")
[ -n "$repo" ] && GH_ARGS+=("--repo" "$repo")

if ! ISSUE_JSON=$(gh "${GH_ARGS[@]}" 2>&1); then
  echo "codu-start: failed to fetch issue #$issue" >&2
  echo "$ISSUE_JSON" >&2
  exit 1
fi

ISSUE_TITLE=$(printf '%s' "$ISSUE_JSON" | jq -r '.title')
ISSUE_URL=$(printf '%s' "$ISSUE_JSON" | jq -r '.url')
ISSUE_BODY=$(printf '%s' "$ISSUE_JSON" | jq -r '.body // "(no body)"')

# Session naming: issue-<N>; collision-safe via suffix if already exists
name="issue-$issue"
if "$TMUX_BIN" has-session -t "$name" 2>/dev/null; then
  name="issue-$issue-$(date +%H%M%S)"
fi

echo "codu-start: launching '$name' for $ISSUE_URL — $ISSUE_TITLE"

# Create + name + launch
"$TMUX_BIN" new-session -d -s "$name" -n "$name" 2>/dev/null
"$TMUX_BIN" set-option -t "$name" "@codu-name" "$name" 2>/dev/null
"$TMUX_BIN" send-keys -t "$name" "$LAUNCHER" Enter 2>/dev/null

# Wait for the TUI to come up before piping the prompt. 2s is conservative
# for codu builder's TUI init. If your machine is slower, bump FLOWEN_START_SETTLE.
sleep "${FLOWEN_START_SETTLE:-2}"

# Compose the kickoff prompt. Templated for issue-driven work; edit to taste.
# NOTE: avoiding apostrophes here because bash parses `$(cat <<EOF ...)` with
# command-substitution semantics, and bare apostrophes can confuse the parser.
PROMPT=$(cat <<EOF
Starting work on $ISSUE_URL — $ISSUE_TITLE

Issue body:
$ISSUE_BODY

Approach:
- Keep an open mind. Reconsider the proposed approach if a cleaner path appears.
- Use the TWIN brain at \$FLOWEN_BRAIN (default ~/Flowen/twin-andie) for context — memory/, experiences/, brain-health/progress.md.
- Do not bend over backward for backwards compatibility — investigate change-once-and-for-all options.
- Update the issue as you discover relevant information, make progress, or make decisions.
- When done, read through changes and simplify; remove unused code paths.
- Finally, ship a PR. If one exists for this issue, update it with progress made.

Start by checking the current state, then propose an approach.
EOF
)

# Pipe the prompt as one block. send-keys with a literal multi-line string
# works in tmux 3+; if your tmux is older, switch to load-buffer + paste-buffer.
"$TMUX_BIN" send-keys -t "$name" "$PROMPT" 2>/dev/null
"$TMUX_BIN" send-keys -t "$name" Enter 2>/dev/null

# Attach
exec "$TMUX_BIN" attach-session -t "$name"
