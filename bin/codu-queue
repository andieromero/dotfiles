#!/usr/bin/env bash
# codu-queue: producer-side helper for the codu builder launch/attach queue files.
#
# Decoupled producer/consumer pattern: anything that wants to open a codu builder
# session (Mission Control button, shell alias, raycast workflow, calendar
# trigger, etc.) writes a JSON line here. The ghostty-session-picker and
# codu-tab-launcher consume on next ghostty tab/window open.
#
# Schema:
#   pending-launches.queue : {"name": "<session>", "venture": "<v>", "launched_at": "<iso8601>"}
#   pending-attaches.queue : {"session_name": "<tmux-session-name>"}
#
# Usage:
#   codu-queue launch <name> [<venture>]   # add a launch intent
#   codu-queue attach <session-name>       # add a resume intent
#   codu-queue list                        # show queued intents
#   codu-queue clear                       # drop all queued intents
#
# Examples:
#   codu-queue launch nestor-deep-dive flowen-os
#   codu-queue attach codu-141522
#
# Queue files live at ~/.flowen/{pending-launches,pending-attaches}.queue.
# Atomic-append via flock-protected `>>`; consumers pop via `tail -n +2 | mv`.

set -euo pipefail

QUEUE_DIR="${CODU_QUEUE_DIR:-$HOME/.flowen}"
LAUNCH_QUEUE="$QUEUE_DIR/pending-launches.queue"
ATTACH_QUEUE="$QUEUE_DIR/pending-attaches.queue"

mkdir -p "$QUEUE_DIR"

usage() {
  cat <<EOF
codu-queue — producer helper for codu builder launch/attach queues

Usage:
  codu-queue launch <name> [<venture>]
  codu-queue attach <session-name>
  codu-queue list
  codu-queue clear

Files:
  $LAUNCH_QUEUE
  $ATTACH_QUEUE
EOF
}

cmd="${1:-help}"
case "$cmd" in
  launch)
    name="${2:?usage: codu-queue launch <name> [<venture>]}"
    venture="${3:-codu}"
    ts=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    # Sanitize: no embedded double-quotes in JSON values
    name=$(printf '%s' "$name" | tr -d '"')
    venture=$(printf '%s' "$venture" | tr -d '"')
    printf '{"name":"%s","venture":"%s","launched_at":"%s"}\n' "$name" "$venture" "$ts" >> "$LAUNCH_QUEUE"
    printf 'queued launch: %s (venture: %s)\n' "$name" "$venture"
    ;;
  attach)
    session="${2:?usage: codu-queue attach <session-name>}"
    session=$(printf '%s' "$session" | tr -d '"')
    printf '{"session_name":"%s"}\n' "$session" >> "$ATTACH_QUEUE"
    printf 'queued attach: %s\n' "$session"
    ;;
  list)
    if [ -s "$LAUNCH_QUEUE" ]; then
      printf '=== pending launches ===\n'
      cat "$LAUNCH_QUEUE"
    else
      printf '(no pending launches)\n'
    fi
    if [ -s "$ATTACH_QUEUE" ]; then
      printf '\n=== pending attaches ===\n'
      cat "$ATTACH_QUEUE"
    else
      printf '\n(no pending attaches)\n'
    fi
    ;;
  clear)
    : > "$LAUNCH_QUEUE"
    : > "$ATTACH_QUEUE"
    printf 'cleared both queues\n'
    ;;
  help|--help|-h|"")
    usage
    ;;
  *)
    printf 'codu-queue: unknown command "%s"\n' "$cmd" >&2
    usage >&2
    exit 2
    ;;
esac
