#!/usr/bin/env bash
# ghostty-session-picker: fzf-based session picker for Ghostty startup
# https://github.com/coa00/ghostty-session-picker

set -euo pipefail

# Ghostty execs this script via `command =` with the bare macOS PATH (it does
# not source zshrc/zprofile). Prepend the locations where flowen / opencode /
# tmux / fzf actually live so `command -v` checks below succeed. Without this,
# the `[new] codu builder` option silently drops out of the picker because
# `command -v flowen` returns false even though the binary is installed.
export PATH="$HOME/.local/bin:/opt/homebrew/bin:$PATH"

ZELLIJ_BIN="${ZELLIJ_BIN:-$(command -v zellij 2>/dev/null || echo "")}"
TMUX_BIN="${TMUX_BIN:-$(command -v tmux 2>/dev/null || echo "/opt/homebrew/bin/tmux")}"
FZF_BIN="${FZF_BIN:-$(command -v fzf 2>/dev/null || echo "/opt/homebrew/bin/fzf")}"
LOG_FILE="${GHOSTTY_SESSION_PICKER_LOG:-$HOME/.local/share/ghostty-session-picker.log}"

if [ -z "$FZF_BIN" ]; then
  echo "Error: fzf is required. Install it with: brew install fzf" >&2
  exec "$SHELL"
fi

CLAUDE_CONTEXT_BIN="$HOME/.local/bin/claude-context-for-pid"
CODU_CONTEXT_BIN="$HOME/.local/bin/codu-context-for-pid"

# --list-only: called by fzf reload after kill. Rebuild choices, print, exit.
# This re-execs the list-building logic without launching fzf again.
LIST_ONLY=0
if [ "${1:-}" = "--list-only" ]; then
  LIST_ONLY=1
fi

log() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') [$$] $*" >> "$LOG_FILE"
}

export TMUX_BIN ZELLIJ_BIN LOG_FILE

# --- Early bypass and queue consumers: skip in --list-only mode ---
if [ "$LIST_ONLY" -eq 0 ]; then

# --- Early bypass: CODU_TAB_ON_OPEN=1 skips fzf entirely ---
# When set in the parent shell, every new ghostty tab/window opens straight
# into a fresh codu builder session. Unset for the next launch to restore the
# picker. Honors CODU_TAB_NAME for explicit naming.
if [ "${CODU_TAB_ON_OPEN:-0}" = "1" ] && [ -x "$HOME/.config/bin/codu-tab-launcher" ]; then
  log "CODU_TAB_ON_OPEN=1 — bypassing picker, exec'ing codu-tab-launcher"
  exec "$HOME/.config/bin/codu-tab-launcher"
fi

# --- Queue consumers (Phase B.1/B.2 consumer side) ---
# Mission Control (or any producer) writes pending launch/attach intents to
# ~/.flowen/*.queue. Picker checks both on startup; first hit wins.
# Producer/consumer decoupling means MC doesn't need IPC with this process;
# it just appends a JSON line and the next ghostty tab/window picks it up.
CODU_QUEUE_DIR="$HOME/.flowen"
LAUNCH_QUEUE="$CODU_QUEUE_DIR/pending-launches.queue"
ATTACH_QUEUE="$CODU_QUEUE_DIR/pending-attaches.queue"

# Attach queue takes priority over launch queue: if user explicitly asked to
# resume an existing session, that intent supersedes a stale launch.
if [ -s "$ATTACH_QUEUE" ] && command -v jq >/dev/null 2>&1 && [ -n "$TMUX_BIN" ]; then
  queued_session=$(head -1 "$ATTACH_QUEUE" | jq -r '.session_name // empty' 2>/dev/null)
  if [ -n "$queued_session" ] && "$TMUX_BIN" has-session -t "$queued_session" 2>/dev/null; then
    log "attach-queue: resuming '$queued_session' (popped from $ATTACH_QUEUE)"
    tail -n +2 "$ATTACH_QUEUE" > "$ATTACH_QUEUE.tmp" 2>/dev/null && mv "$ATTACH_QUEUE.tmp" "$ATTACH_QUEUE"
    exec "$TMUX_BIN" attach-session -t "$queued_session"
  fi
fi

if [ -s "$LAUNCH_QUEUE" ] && command -v jq >/dev/null 2>&1 && [ -x "$HOME/.config/bin/codu-tab-launcher" ]; then
  # Name is consumed by codu-tab-launcher itself (see its queue logic).
  # We just exec it; the launcher's own queue-pop happens there.
  log "launch-queue: non-empty — exec'ing codu-tab-launcher (pops queue)"
  exec "$HOME/.config/bin/codu-tab-launcher"
fi

fi  # end LIST_ONLY == 0 guard

# Restore last working directory
cd_to_last_dir() {
  local dir=""
  if [ -n "${TMUX:-}" ] && [ -n "$TMUX_BIN" ]; then
    dir=$("$TMUX_BIN" display-message -p -t '{last}' '#{pane_current_path}' 2>/dev/null || true)
  fi
  if [ -z "$dir" ] && [ -f "$HOME/.last_working_dir" ]; then
    dir=$(cat "$HOME/.last_working_dir")
  fi
  if [ -n "$dir" ] && [ -d "$dir" ]; then
    log "cd to last dir: $dir"
    cd "$dir"
  fi
}

# Build the selection list
choices=""

# Existing zellij sessions (only if zellij is installed)
if [ -n "$ZELLIJ_BIN" ]; then
  zellij_sessions=$("$ZELLIJ_BIN" list-sessions --no-formatting --short 2>/dev/null || true)
  if [ -n "$zellij_sessions" ]; then
    choices=$(echo "$zellij_sessions" | sed 's/^/[zellij] /')
  fi
fi

# Existing tmux sessions — show Claude session names when running
if [ -n "$TMUX_BIN" ]; then
  SESSIONS_DIR="$HOME/.claude/sessions"
  tmux_items=""

  # Group by session: for each session, find the best label.
  # Priority: Claude/codu tag > first window name > session name.
    # Both runtimes can coexist in different panes of the same tmux session, so
    # we capture each independently and the tag reflects whichever (or both) we find.
  now_epoch=$(date +%s)
  while IFS= read -r sess_line; do
    sess_name="${sess_line%% *}"
    sess_activity="${sess_line##* }"
    claude_names=""
    codu_found=""
    win_names=""
    context_info=""
    plan_info=""
    git_dirty=0
    git_unpushed=0
    git_branch=""

    # Check for plan attached to this session
    plan_val=$("$TMUX_BIN" show-options -t "$sess_name" -v "@codu-plan" 2>/dev/null || true)
    [ -n "$plan_val" ] && plan_info="$plan_val"

    # Read session state file for git info (updated every 5s by codu-tmux-status)
    SESSION_STATE="$HOME/.flowen/sessions/${sess_name}.json"
    if [ -f "$SESSION_STATE" ] && command -v jq >/dev/null 2>&1; then
      # Aggregate across all repos this session has touched
      git_branch=$(jq -r '[.repos[].current_branch] | join(",")' "$SESSION_STATE" 2>/dev/null || true)
      git_dirty=$(jq '[.repos[].dirty] | add // 0' "$SESSION_STATE" 2>/dev/null || echo 0)
      git_unpushed=$(jq '[.repos[].unpushed] | add // 0' "$SESSION_STATE" 2>/dev/null || echo 0)
      all_branches=$(jq -r '[.repos[].branches[]] | unique | join(",")' "$SESSION_STATE" 2>/dev/null || true)
      repo_count=$(jq '.repos | length' "$SESSION_STATE" 2>/dev/null || echo 0)
      # Show all branches if session touched multiple
      if [ "$repo_count" -gt 1 ] 2>/dev/null || [ "$(echo "$all_branches" | tr ',' '\n' | wc -l | tr -d ' ')" -gt 1 ] 2>/dev/null; then
        git_branch="$all_branches"
      fi
    else
      # Fallback: live git check
      pane_path=$("$TMUX_BIN" display-message -t "$sess_name" -p '#{pane_current_path}' 2>/dev/null || true)
      if [ -n "$pane_path" ] && git -C "$pane_path" rev-parse --git-dir >/dev/null 2>&1; then
        git_branch=$(git -C "$pane_path" branch --show-current 2>/dev/null || true)
        git_dirty=$(git -C "$pane_path" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
        git_unpushed=$(git -C "$pane_path" log --oneline '@{upstream}..HEAD' 2>/dev/null | wc -l | tr -d ' ')
      fi
    fi

    # Compute relative age from last activity
    age_str=""
    if [ -n "$sess_activity" ] && [ "$sess_activity" -gt 0 ] 2>/dev/null; then
      age_s=$((now_epoch - sess_activity))
      if [ "$age_s" -lt 60 ]; then
        age_str="now"
      elif [ "$age_s" -lt 3600 ]; then
        age_str="$((age_s / 60))m ago"
      elif [ "$age_s" -lt 86400 ]; then
        age_str="$((age_s / 3600))h ago"
      else
        age_str="$((age_s / 86400))d ago"
      fi
    fi

    while IFS= read -r wline; do
      # Format: window_name pane_pid
      win_name="${wline%% *}"
      pane_pid="${wline##* }"
      win_names="${win_names:+$win_names, }$win_name"

      # Walk this pane's descendants once; check each child for claude or codu builder.
      for cpid in $(ps -eo pid,ppid 2>/dev/null | awk -v p="$pane_pid" '$2==p {print $1}'); do
        # Claude Code: has a session JSON under ~/.claude/sessions/<pid>.json
        if [ -d "$SESSIONS_DIR" ] && [ -f "$SESSIONS_DIR/$cpid.json" ]; then
          cname=""
          cnamesrc=""
          if command -v jq &>/dev/null; then
            cname=$(jq -r '.name // empty' "$SESSIONS_DIR/$cpid.json" 2>/dev/null)
            cnamesrc=$(jq -r '.nameSource // empty' "$SESSIONS_DIR/$cpid.json" 2>/dev/null)
          fi
          # A "derived" name is Claude's cwd-based auto-guess (e.g. twin-andie-6c)
          # — every session in the same repo collides on it. It must NOT override
          # the human-picked tmux session name. Only a user /rename (nameSource
          # != derived) beats the tmux session name. Fall back to sess_name.
          if [ -z "$cname" ] || [ "$cnamesrc" = "derived" ]; then
            cname="$sess_name"
          fi
          claude_names="${claude_names:+$claude_names, }$cname"
          # Grab context stats for this Claude process
          if [ -x "$CLAUDE_CONTEXT_BIN" ]; then
            ctx=$("$CLAUDE_CONTEXT_BIN" "$cpid" 2>/dev/null || true)
            [ -n "$ctx" ] && context_info="$ctx"
          fi
          continue
        fi
        # codu builder: detect by process name (no per-session JSON file like claude has).
        # The TUI binary is `opencode` in its argv[0]. Check the command field.
        ccmd=$(ps -p "$cpid" -o command= 2>/dev/null)
        case "$ccmd" in
          *opencode*)
            codu_found=1
            # Grab context stats for this codu builder process
            if [ -x "$CODU_CONTEXT_BIN" ]; then
              ctx=$("$CODU_CONTEXT_BIN" "$cpid" 2>/dev/null || true)
              [ -n "$ctx" ] && context_info="$ctx"
            fi
            ;;
        esac
      done
    done < <("$TMUX_BIN" list-windows -t "$sess_name" -F "#{window_name} #{pane_pid}" 2>/dev/null)

    # Compose compact label with dot-leader alignment.
    # Tags: codu = codu builder, cc = claude code, -- = plain shell
    if [ -n "$claude_names" ] && [ -n "$codu_found" ]; then
      tag="codu+cc"
      label="${claude_names}"
    elif [ -n "$claude_names" ]; then
      tag="cc"
      label="${claude_names}"
    elif [ -n "$codu_found" ]; then
      tag="codu"
      label="${win_names:-$sess_name}"
    else
      tag="--"
      label="${win_names:-$sess_name}"
    fi
    # Build fixed-width right columns: tokens(5) cost(4) age(3)
    # Color tokens by threshold: green <100K, yellow 100-200K, red >200K
    col_tok=""
    col_tok_colored=""
    col_cost=""
    col_age=""
    if [ -n "$context_info" ]; then
      # context_info is like "272K  $27.44" — split into token + cost
      col_tok=$(echo "$context_info" | awk '{print $1}')
      col_cost=$(echo "$context_info" | awk '{c=$2; gsub(/\.[0-9]*$/,"",c); if(c=="$0") c="<$1"; print c}')
      # Parse token count to number for color thresholds
      tok_num=0
      case "$col_tok" in
        *M) tok_num=$(echo "$col_tok" | sed 's/M//' | awk '{printf "%d", $1 * 1000}') ;;
        *K) tok_num=$(echo "$col_tok" | sed 's/K//') ;;
        *)  tok_num="$col_tok" ;;
      esac
      # Color: green(<100K) yellow(100-200K) red(>200K)
      if [ "$tok_num" -gt 200 ] 2>/dev/null; then
        col_tok_colored="\033[31m$(printf '%5s' "$col_tok")\033[0m"  # red
      elif [ "$tok_num" -gt 100 ] 2>/dev/null; then
        col_tok_colored="\033[33m$(printf '%5s' "$col_tok")\033[0m"  # yellow
      else
        col_tok_colored="\033[32m$(printf '%5s' "$col_tok")\033[0m"  # green
      fi
    fi
    [ -n "$age_str" ] && col_age=$(echo "$age_str" | sed 's/ ago//')
    # Compose right side — plain version for dot-leader width calc
    meta_right=""
    [ -n "$col_tok" ] && meta_right=$(printf '%5s' "$col_tok")
    [ -n "$col_cost" ] && meta_right="${meta_right} $(printf '%-4s' "$col_cost")"
    [ -n "$col_age" ] && meta_right="${meta_right:+$meta_right }$(printf '%-3s' "$col_age")"
    # Colored version for display (ANSI codes don't affect fzf width with --ansi)
    meta_colored=""
    [ -n "$col_tok_colored" ] && meta_colored="${col_tok_colored}"
    [ -n "$col_cost" ] && meta_colored="${meta_colored} $(printf '%-4s' "$col_cost")"
    [ -n "$col_age" ] && meta_colored="${meta_colored:+$meta_colored }$(printf '%-3s' "$col_age")"
    # If only age (no context), just show age right-aligned
    if [ -z "$col_tok" ] && [ -n "$col_age" ]; then
      meta_right="$col_age"
      meta_colored="$col_age"
    fi
    [ -n "$plan_info" ] && meta_right="${meta_right:+$meta_right }${plan_info}" && meta_colored="${meta_colored:+$meta_colored }${plan_info}"
    # Git info: aggregate dirty/unpushed across all repos (no branch name — could be many)
    git_suffix=""
    git_suffix_plain=""
    parts=""
    parts_plain=""
    if [ "$git_dirty" -gt 0 ] 2>/dev/null; then
      parts="\033[31m●${git_dirty}\033[0m"
      parts_plain="●${git_dirty}"
    fi
    if [ "$git_unpushed" -gt 0 ] 2>/dev/null; then
      parts="${parts:+$parts }\033[32m↑${git_unpushed}\033[0m"
      parts_plain="${parts_plain:+$parts_plain }↑${git_unpushed}"
    fi
    [ -n "$parts" ] && git_suffix=" ${parts}" && git_suffix_plain=" ${parts_plain}"
    left="${tag} ${label}${git_suffix}"
    left_plain="${tag} ${label}${git_suffix_plain}"
    if [ -n "$meta_right" ]; then
      left_len=${#left_plain}
      right_len=${#meta_right}
      # Compact width for split screens — hscroll handles overflow
      total=52
      dots_len=$((total - left_len - right_len - 2))
      [ "$dots_len" -lt 2 ] && dots_len=2
      dots=$(printf '%*s' "$dots_len" '' | tr ' ' '·')
      item="${left} \033[90m${dots}\033[0m ${meta_colored}§${sess_name}"
    else
      item="${left}§${sess_name}"
    fi
    tmux_items="${tmux_items:+$tmux_items\n}$item"
  done < <("$TMUX_BIN" list-sessions -F "#{session_name} #{session_activity}" 2>/dev/null)

  if [ -n "$tmux_items" ]; then
    if [ -n "$choices" ]; then
      choices="$choices\n$tmux_items"
    else
      choices="$tmux_items"
    fi
  fi
fi

# New session options.
# Order matters: fzf's default cursor lands on the first row, so the first
# option here is the one a fresh terminal opens with a single Enter.
# Claude on top — default new session.
new_options=""
[ -n "$TMUX_BIN" ] && new_options="++ claude"
[ -n "$TMUX_BIN" ] && new_options="${new_options:+$new_options\n}++ tmux"
new_options="${new_options:+$new_options\n}++ shell"
[ -n "$ZELLIJ_BIN" ] && new_options="$new_options\n++ zellij"
if [ -n "$TMUX_BIN" ] && command -v flowen >/dev/null 2>&1; then
  new_options="${new_options:+$new_options\n}++ codu builder"
elif [ -n "$TMUX_BIN" ] && command -v opencode >/dev/null 2>&1; then
  new_options="${new_options:+$new_options\n}++ codu builder"
fi

if [ -n "$choices" ]; then
  choices="$new_options\n$choices"
else
  choices="$new_options"
fi

# --list-only: just print the refreshed choices for fzf reload, then exit.
if [ "$LIST_ONLY" -eq 1 ]; then
  echo -e "$choices"
  exit 0
fi

# Write choices to a temp file so fzf reload can regenerate the list after kills.
# The regeneration re-runs this script's list-building logic via a helper.
CHOICES_FILE=$(mktemp /tmp/ghostty-picker-XXXXXX)
echo -e "$choices" > "$CHOICES_FILE"
trap 'rm -f "$CHOICES_FILE"' EXIT

# Kill commands for fzf --bind.
# fzf passes selected lines via {+f} (file with selected items, one per line).
SESSION_KILL="$HOME/.local/bin/session-kill"

# ctrl-x: safe kill — ends process (frees RAM), keeps conversation in DB
SAFE_KILL_CMD="while IFS= read -r line; do case \"\$line\" in '++'*) continue ;; esac; sess=\${line##*§}; [ -z \"\$sess\" ] && continue; att=\$($TMUX_BIN display-message -p '#{session_name}' 2>/dev/null || true); [ \"\$sess\" = \"\$att\" ] && continue; $TMUX_BIN kill-session -t \"\$sess\" 2>/dev/null; done < {+f}; $0 --list-only"

# ctrl-d: full delete — ends process AND deletes conversation from DB
FULL_DELETE_CMD="while IFS= read -r line; do case \"\$line\" in '++'*) continue ;; esac; sess=\${line##*§}; [ -z \"\$sess\" ] && continue; att=\$($TMUX_BIN display-message -p '#{session_name}' 2>/dev/null || true); [ \"\$sess\" = \"\$att\" ] && continue; $SESSION_KILL \"\$sess\" 2>/dev/null; done < {+f}; $0 --list-only"

# --list-only: when called with this flag, just print the choices and exit
# (used by fzf reload after kills). Detected at the top of the script below.
# For now, show fzf with the pre-built list.
G='\033[32m' Y='\033[33m' R='\033[31m' C='\033[36m' D='\033[2m' N='\033[0m'
TIPS_CMD="echo -e \"\
\n\
  ${D}LEGEND${N}\n\
  codu  codu builder     ++  new session\n\
  cc    claude code      --  plain shell\n\
  ${R}●${N}     uncommitted     ${G}↑${N}   unpushed\n\
\n\
  ${D}CONTEXT${N}\n\
  ${G}  88K  healthy${N}\n\
  ${Y} 150K  consider /compact${N}\n\
  ${R} 272K  degraded — compact or clear${N}\n\
  \\\$6    session cost    3d   last active\n\
\n\
  ${D}IDLE SESSIONS COST \\\$0${N}\n\
  the \\\$ amount is what was ${D}already spent${N}\n\
  idle sessions make zero API calls\n\
  they only use ${Y}~200MB RAM${N} per session\n\
  cost resumes when you send a message:\n\
  ${G}<100K${N} ~\\\$0.06/msg  ${Y}200K${N} ~\\\$0.30/msg  ${R}500K${N} ~\\\$2/msg\n\
\n\
  ${D}ACTIONS${N}\n\
  ${G}ctrl-w${N}  wrap + attach\n\
          opens session and runs /wrap:\n\
          git check → /learn → handoff\n\
          ${D}safest way to close a session${N}\n\
\n\
  ${C}ctrl-f${N}  fork session\n\
          new session with old conversation\n\
          original stays untouched\n\
\n\
  ${Y}ctrl-x${N}  safe kill\n\
          ends process, frees RAM\n\
          conversation stays, resume later\n\
\n\
  ${R}ctrl-d${N}  full delete ${D}(cannot undo)${N}\n\
          kills + deletes conversation\n\
          frees RAM + context + disk\n\
\n\
  ${D}WHEN TO /WRAP VS CLEAR${N}\n\
  ${R}●${N} showing?  attach + commit first\n\
  ${Y}100-200K${N}    /wrap to learn + compact\n\
  ${R}>200K${N}       /wrap first, then ctrl-d\n\
  ${D}stale 3d+${N}   ctrl-d if nothing to save\n\
\""

selected=$(cat "$CHOICES_FILE" | "$FZF_BIN" \
  --height=100% \
  --layout=reverse \
  --border=rounded \
  --border-label=' sessions ' \
  --border-label-pos=2 \
  --prompt="session > " \
  --header='enter·attach  ctrl-w·wrap  ctrl-f·fork  ctrl-x·kill  ctrl-d·delete' \
  --expect='ctrl-w,ctrl-f' \
  --ansi \
  --hscroll-off=10 \
  --scrollbar='▐' \
  --no-info \
  --multi \
  --delimiter='§' \
  --with-nth=1 \
  --preview="$TIPS_CMD" \
  --preview-window='down,50%,border-rounded' \
  --preview-label=' codu guide ' \
  --preview-label-pos=2 \
  --bind "ctrl-x:execute-silent($SAFE_KILL_CMD)+reload($0 --list-only)" \
  --bind "ctrl-d:execute-silent($FULL_DELETE_CMD)+reload($0 --list-only)" \
  --color=pointer:green,prompt:blue,header:dim) || {
  # If fzf is cancelled (Esc/Ctrl-C), start plain shell
  exec "$SHELL"
}
# --expect makes fzf output: line 1 = key pressed, line 2+ = selections
fzf_key=$(echo "$selected" | head -1)
all_selected=$(echo "$selected" | tail -n +2)
selected=$(echo "$all_selected" | head -1)
WRAP_ON_ATTACH=0
FORK_SESSION=0
[ "$fzf_key" = "ctrl-w" ] && WRAP_ON_ATTACH=1
[ "$fzf_key" = "ctrl-f" ] && FORK_SESSION=1

log "selected: $selected (key: $fzf_key, wrap: $WRAP_ON_ATTACH, fork: $FORK_SESSION, count: $(echo "$all_selected" | wc -l | tr -d ' '))"

case "$selected" in
  "++ shell")
    log "launching plain shell"
    cd_to_last_dir
    exec "$SHELL"
    ;;
  "++ zellij")
    printf "Session name (empty for default): " > /dev/tty
    read -r session_name < /dev/tty
    cd_to_last_dir
    if [ -z "$session_name" ]; then
      log "launching new zellij (default name)"
      exec "$ZELLIJ_BIN"
    else
      log "launching new zellij: $session_name"
      exec "$ZELLIJ_BIN" -s "$session_name"
    fi
    ;;
  "++ tmux")
    name="ghostty-$$"
    if "$TMUX_BIN" has-session -t "$name" 2>/dev/null; then
      name="ghostty-$$-$(date +%H%M%S)"
      log "session collision; renamed to $name"
    fi
    log "launching new tmux: $name"
    cd_to_last_dir
    set +e
    "$TMUX_BIN" new-session -s "$name" 2>>"$LOG_FILE"
    rc=$?
    log "tmux new-session exited with code $rc"
    exec "$SHELL"
    ;;
  "++ claude")
    # AVE picker → Plan picker → Session starts
    AVE_PICKER="$HOME/.local/bin/codu-ave-picker"
    ave_name=""
    if [ -x "$AVE_PICKER" ]; then
      ave_name=$("$AVE_PICKER" < /dev/tty 2>/dev/tty || true)
    fi
    # Switch AVE if selected
    if [ -n "$ave_name" ] && command -v flowen >/dev/null 2>&1; then
      flowen ave switch "$ave_name" 2>/dev/null || true
      log "switched AVE to $ave_name"
    fi
    # Plan picker
    plan_name=""
    PLAN_PICKER="$HOME/.local/bin/codu-plan-picker"
    if [ -x "$PLAN_PICKER" ]; then
      plan_name=$("$PLAN_PICKER" < /dev/tty 2>/dev/tty || true)
    fi
    if [ -n "$plan_name" ]; then
      raw_name="$plan_name"
    else
      printf "Session name (empty = auto): " > /dev/tty
      read -r raw_name < /dev/tty
    fi
    # Sanitize: tmux session names disallow ':' and '.'; keep it filesystem-safe.
    name=$(printf '%s' "$raw_name" | tr -c 'A-Za-z0-9_-' '-' | sed 's/^-*//;s/-*$//')
    [ -z "$name" ] && name="claude-$$"
    # Collision guard: a duplicate-session error from `tmux new-session` is
    # silently fatal — without this check, the script falls through to send-keys
    # + attach against the EXISTING session, which (if it's running a different
    # runtime) types `claude` into that runtime's prompt. Mirror codu-start.
    if "$TMUX_BIN" has-session -t "$name" 2>/dev/null; then
      orig_name="$name"
      name="${name}-$(date +%H%M%S)"
      log "session '$orig_name' already exists; renaming to '$name'"
      printf "Session '%s' exists — using '%s' instead.\n" "$orig_name" "$name" > /dev/tty
    fi
    cd_to_last_dir
    log "launching new claude tmux session: $name (raw: $raw_name, plan: $plan_name)"
    set +e
    # Set the @claude-name option BEFORE claude starts so the SessionStart hook
    # (claude-tmux-sync) sees it. Then run claude inside the named session.
    "$TMUX_BIN" new-session -d -s "$name" -n "$name" 2>>"$LOG_FILE"
    "$TMUX_BIN" set-option -t "$name" "@claude-name" "$name" 2>>"$LOG_FILE"
    [ -n "$ave_name" ] && "$TMUX_BIN" set-option -t "$name" "@codu-ave" "$ave_name" 2>>"$LOG_FILE"
    [ -n "$plan_name" ] && "$TMUX_BIN" set-option -t "$name" "@codu-plan" "$plan_name" 2>>"$LOG_FILE"
    "$TMUX_BIN" send-keys -t "$name" "claude" Enter 2>>"$LOG_FILE"
    # If a plan was selected, send /dispatch after a brief delay for claude to boot
    if [ -n "$plan_name" ]; then
      sleep 4
      "$TMUX_BIN" send-keys -t "$name" "/dispatch $plan_name" Enter 2>>"$LOG_FILE"
    fi
    "$TMUX_BIN" attach-session -t "$name" 2>>"$LOG_FILE"
    rc=$?
    log "tmux new claude-session exited with code $rc"
    exec "$SHELL"
    ;;
  "++ codu builder")
    # AVE picker → Plan picker → Session starts
    # Launcher: flowen repl (AVE-aware) or raw opencode fallback
    if command -v flowen >/dev/null 2>&1; then
      launcher="flowen repl"
    else
      launcher="opencode --agent ${OPENCODE_AGENT:-codu}"
    fi
    # AVE picker
    AVE_PICKER="$HOME/.local/bin/codu-ave-picker"
    ave_name=""
    if [ -x "$AVE_PICKER" ]; then
      ave_name=$("$AVE_PICKER" < /dev/tty 2>/dev/tty || true)
    fi
    if [ -n "$ave_name" ] && command -v flowen >/dev/null 2>&1; then
      flowen ave switch "$ave_name" 2>/dev/null || true
      log "switched AVE to $ave_name"
    fi
    # Plan picker with task preview
    plan_name=""
    PLAN_PICKER="$HOME/.local/bin/codu-plan-picker"
    if [ -x "$PLAN_PICKER" ]; then
      plan_name=$("$PLAN_PICKER" < /dev/tty 2>/dev/tty || true)
    fi
    if [ -n "$plan_name" ]; then
      raw_name="$plan_name"
    else
      printf "Session name (empty = auto): " > /dev/tty
      read -r raw_name < /dev/tty
    fi
    name=$(printf '%s' "$raw_name" | tr -c 'A-Za-z0-9_-' '-' | sed 's/^-*//;s/-*$//')
    [ -z "$name" ] && name="codu-$$"
    # Collision guard — see claude branch for the why. Critical here: if a
    # claude-running session already owns this name, attaching + send-keys would
    # type `flowen repl` straight into the claude TUI's prompt.
    if "$TMUX_BIN" has-session -t "$name" 2>/dev/null; then
      orig_name="$name"
      name="${name}-$(date +%H%M%S)"
      log "session '$orig_name' already exists; renaming to '$name'"
      printf "Session '%s' exists — using '%s' instead.\n" "$orig_name" "$name" > /dev/tty
    fi
    cd_to_last_dir
    log "launching new codu builder tmux session: $name (raw: $raw_name, plan: $plan_name, launcher: $launcher)"
    set +e
    "$TMUX_BIN" new-session -d -s "$name" -n "$name" 2>>"$LOG_FILE"
    "$TMUX_BIN" set-option -t "$name" "@codu-name" "$name" 2>>"$LOG_FILE"
    # Store AVE + plan as tmux user options for status bar + future tools
    [ -n "$ave_name" ] && "$TMUX_BIN" set-option -t "$name" "@codu-ave" "$ave_name" 2>>"$LOG_FILE"
    [ -n "$plan_name" ] && "$TMUX_BIN" set-option -t "$name" "@codu-plan" "$plan_name" 2>>"$LOG_FILE"
    "$TMUX_BIN" send-keys -t "$name" "$launcher" Enter 2>>"$LOG_FILE"
    # If a plan was selected, send /dispatch after a brief delay for the agent to boot
    if [ -n "$plan_name" ]; then
      sleep 3
      "$TMUX_BIN" send-keys -t "$name" "/dispatch $plan_name" Enter 2>>"$LOG_FILE"
    fi
    "$TMUX_BIN" attach-session -t "$name" 2>>"$LOG_FILE"
    rc=$?
    log "tmux new codu-session exited with code $rc"
    exec "$SHELL"
    ;;
  "codu "*|"cc "*|"codu+cc "*|"-- "*)
    # All existing sessions — tag is just display. Session name after § delimiter.
    session_name="${selected##*§}"

    # ctrl-w: send /wrap to selected sessions, then attach to first
    if [ "$WRAP_ON_ATTACH" -eq 1 ]; then
      # Send /wrap to ALL selected sessions
      echo "$all_selected" | while IFS= read -r line; do
        case "$line" in '++'*) continue ;; esac
        sess="${line##*§}"
        [ -z "$sess" ] && continue
        log "sending /wrap to: $sess"
        "$TMUX_BIN" send-keys -t "$sess" "/wrap" Enter 2>>"$LOG_FILE"
      done
      # Attach to the first one so user can watch /wrap run
      log "attaching to first: $session_name"
      set +e
      "$TMUX_BIN" attach-session -t "$session_name" 2>>"$LOG_FILE"
      rc=$?
      log "tmux attach exited with code $rc"
      exec "$SHELL"

    # ctrl-f: fork — new session with the old conversation as context
    elif [ "$FORK_SESSION" -eq 1 ]; then
      log "forking: $session_name"
      # Find the agent type + session ID from the old tmux session
      old_pane_pid=$("$TMUX_BIN" list-windows -t "$session_name" -F "#{pane_pid}" 2>/dev/null | head -1)
      fork_cmd=""
      fork_type=""
      if [ -n "$old_pane_pid" ]; then
        for cpid in $(ps -eo pid,ppid 2>/dev/null | awk -v p="$old_pane_pid" '$2==p {print $1}'); do
          cmd=$(ps -p "$cpid" -o command= 2>/dev/null || true)
          case "$cmd" in
            *opencode*)
              fork_type="codu"
              # Extract -s session ID if present
              oc_sid=$(echo "$cmd" | grep -o '\-s ses_[^ ]*' | sed 's/-s //' || true)
              if [ -z "$oc_sid" ]; then
                # Fallback: fork the most recent session
                fork_cmd="opencode --agent codu --fork -c"
              else
                fork_cmd="opencode --agent codu --fork -s $oc_sid"
              fi
              break
              ;;
          esac
          if [ -f "$HOME/.claude/sessions/$cpid.json" ]; then
            fork_type="claude"
            claude_sid=$(jq -r '.sessionId // empty' "$HOME/.claude/sessions/$cpid.json" 2>/dev/null)
            if [ -n "$claude_sid" ]; then
              fork_cmd="claude --resume $claude_sid --fork-session"
            else
              fork_cmd="claude --continue --fork-session"
            fi
            break
          fi
        done
      fi
      # Fallback if we couldn't detect
      if [ -z "$fork_cmd" ]; then
        fork_cmd="opencode --agent codu --fork -c"
        fork_type="codu"
      fi
      # Create new tmux session named <old>-fork
      new_name="${session_name}-fork"
      if "$TMUX_BIN" has-session -t "$new_name" 2>/dev/null; then
        new_name="${session_name}-fork-$(date +%H%M%S)"
      fi
      cd_to_last_dir
      log "forking $session_name → $new_name (type: $fork_type, cmd: $fork_cmd)"
      set +e
      "$TMUX_BIN" new-session -d -s "$new_name" -n "$new_name" 2>>"$LOG_FILE"
      "$TMUX_BIN" send-keys -t "$new_name" "$fork_cmd" Enter 2>>"$LOG_FILE"
      "$TMUX_BIN" attach-session -t "$new_name" 2>>"$LOG_FILE"
      rc=$?
      log "fork session exited with code $rc"
      exec "$SHELL"

    # Default: attach + auto-resume last conversation if agent is running
    else
      # Check if this session has a codu builder / opencode process running
      attach_pane_pid=$("$TMUX_BIN" list-windows -t "$session_name" -F "#{pane_pid}" 2>/dev/null | head -1)
      has_agent=0
      if [ -n "$attach_pane_pid" ]; then
        for cpid in $(ps -eo pid,ppid 2>/dev/null | awk -v p="$attach_pane_pid" '$2==p {print $1}'); do
          cmd=$(ps -p "$cpid" -o command= 2>/dev/null || true)
          case "$cmd" in *opencode*) has_agent=1; break ;; esac
          [ -f "$HOME/.claude/sessions/$cpid.json" ] && has_agent=1 && break
        done
      fi
      if [ "$has_agent" -eq 1 ] && [ -n "${TMUX:-}" ]; then
        # Agent is running AND we're already inside tmux (switching sessions, not cold-attaching).
        # Send /sessions to open the conversation picker so the user lands in their last conversation.
        # Don't do this on cold attach — the TUI isn't ready yet and the command leaks into the prompt.
        log "switching to session with agent: $session_name (sending /sessions)"
        "$TMUX_BIN" send-keys -t "$session_name" "/sessions" Enter 2>>"$LOG_FILE"
      else
        log "attaching: $session_name (agent=$has_agent, inside_tmux=${TMUX:-no})"
      fi
      set +e
      "$TMUX_BIN" attach-session -t "$session_name" 2>>"$LOG_FILE"
      rc=$?
      log "tmux attach exited with code $rc"
      exec "$SHELL"
    fi
    ;;
  *)
    log "unknown selection: $selected"
    exec "$SHELL"
    ;;
esac
