#!/usr/bin/env bash
# ghostty-session-picker: fzf-based session picker for Ghostty startup
# https://github.com/coa00/ghostty-session-picker

set -euo pipefail

# Ghostty execs this script via `command =` with the bare macOS PATH (it does
# not source zshrc/zprofile). Prepend the locations where flowen / opencode /
# tmux / fzf actually live so `command -v` checks below succeed. Without this,
# the `[new] flowen repl` option silently drops out of the picker because
# `command -v flowen` returns false even though the binary is installed.
export PATH="$HOME/.local/bin:/opt/homebrew/bin:$PATH"

ZELLIJ_BIN="${ZELLIJ_BIN:-$(command -v zellij 2>/dev/null || echo "")}"
TMUX_BIN="${TMUX_BIN:-$(command -v tmux 2>/dev/null || echo "/opt/homebrew/bin/tmux")}"
FZF_BIN="${FZF_BIN:-$(command -v fzf 2>/dev/null || echo "/opt/homebrew/bin/fzf")}"
LOG_FILE="${GHOSTTY_SESSION_PICKER_LOG:-$HOME/.local/share/ghostty-session-picker.log}"

if [ -z "$FZF_BIN" ]; then
  echo "Error: fzf is required. Install it with: brew install fzf" >&2
  exec "$SHELL"
fi

CLAUDE_CONTEXT_BIN="$HOME/.local/bin/claude-context-for-pid"
OC_CONTEXT_BIN="$HOME/.local/bin/opencode-context-for-pid"

# --list-only: called by fzf reload after kill. Rebuild choices, print, exit.
# This re-execs the list-building logic without launching fzf again.
LIST_ONLY=0
if [ "${1:-}" = "--list-only" ]; then
  LIST_ONLY=1
fi

log() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') [$$] $*" >> "$LOG_FILE"
}

export TMUX_BIN ZELLIJ_BIN LOG_FILE

# --- Early bypass and queue consumers: skip in --list-only mode ---
if [ "$LIST_ONLY" -eq 0 ]; then

# --- Early bypass: FLOWEN_TAB_ON_OPEN=1 skips fzf entirely ---
# When set in the parent shell, every new ghostty tab/window opens straight
# into a fresh flowen repl session. Unset for the next launch to restore the
# picker. Honors FLOWEN_TAB_NAME for explicit naming.
if [ "${FLOWEN_TAB_ON_OPEN:-0}" = "1" ] && [ -x "$HOME/.config/bin/flowen-tab-launcher" ]; then
  log "FLOWEN_TAB_ON_OPEN=1 — bypassing picker, exec'ing flowen-tab-launcher"
  exec "$HOME/.config/bin/flowen-tab-launcher"
fi

# --- Queue consumers (Phase B.1/B.2 consumer side) ---
# Mission Control (or any producer) writes pending launch/attach intents to
# ~/.flowen/*.queue. Picker checks both on startup; first hit wins.
# Producer/consumer decoupling means MC doesn't need IPC with this process;
# it just appends a JSON line and the next ghostty tab/window picks it up.
FLOWEN_QUEUE_DIR="$HOME/.flowen"
LAUNCH_QUEUE="$FLOWEN_QUEUE_DIR/pending-launches.queue"
ATTACH_QUEUE="$FLOWEN_QUEUE_DIR/pending-attaches.queue"

# Attach queue takes priority over launch queue: if user explicitly asked to
# resume an existing session, that intent supersedes a stale launch.
if [ -s "$ATTACH_QUEUE" ] && command -v jq >/dev/null 2>&1 && [ -n "$TMUX_BIN" ]; then
  queued_session=$(head -1 "$ATTACH_QUEUE" | jq -r '.session_name // empty' 2>/dev/null)
  if [ -n "$queued_session" ] && "$TMUX_BIN" has-session -t "$queued_session" 2>/dev/null; then
    log "attach-queue: resuming '$queued_session' (popped from $ATTACH_QUEUE)"
    tail -n +2 "$ATTACH_QUEUE" > "$ATTACH_QUEUE.tmp" 2>/dev/null && mv "$ATTACH_QUEUE.tmp" "$ATTACH_QUEUE"
    exec "$TMUX_BIN" attach-session -t "$queued_session"
  fi
fi

if [ -s "$LAUNCH_QUEUE" ] && command -v jq >/dev/null 2>&1 && [ -x "$HOME/.config/bin/flowen-tab-launcher" ]; then
  # Name is consumed by flowen-tab-launcher itself (see its queue logic).
  # We just exec it; the launcher's own queue-pop happens there.
  log "launch-queue: non-empty — exec'ing flowen-tab-launcher (pops queue)"
  exec "$HOME/.config/bin/flowen-tab-launcher"
fi

fi  # end LIST_ONLY == 0 guard

# Restore last working directory
cd_to_last_dir() {
  local dir=""
  if [ -n "${TMUX:-}" ] && [ -n "$TMUX_BIN" ]; then
    dir=$("$TMUX_BIN" display-message -p -t '{last}' '#{pane_current_path}' 2>/dev/null || true)
  fi
  if [ -z "$dir" ] && [ -f "$HOME/.last_working_dir" ]; then
    dir=$(cat "$HOME/.last_working_dir")
  fi
  if [ -n "$dir" ] && [ -d "$dir" ]; then
    log "cd to last dir: $dir"
    cd "$dir"
  fi
}

# Build the selection list
choices=""

# Existing zellij sessions (only if zellij is installed)
if [ -n "$ZELLIJ_BIN" ]; then
  zellij_sessions=$("$ZELLIJ_BIN" list-sessions --no-formatting --short 2>/dev/null || true)
  if [ -n "$zellij_sessions" ]; then
    choices=$(echo "$zellij_sessions" | sed 's/^/[zellij] /')
  fi
fi

# Existing tmux sessions — show Claude session names when running
if [ -n "$TMUX_BIN" ]; then
  SESSIONS_DIR="$HOME/.claude/sessions"
  tmux_items=""

  # Group by session: for each session, find the best label.
  # Priority: Claude/opencode tag > first window name > session name.
  # Both runtimes can coexist in different panes of the same tmux session, so
  # we capture each independently and the tag reflects whichever (or both) we find.
  while IFS= read -r sess_name; do
    claude_names=""
    opencode_found=""
    win_names=""
    context_info=""

    while IFS= read -r wline; do
      # Format: window_name pane_pid
      win_name="${wline%% *}"
      pane_pid="${wline##* }"
      win_names="${win_names:+$win_names, }$win_name"

      # Walk this pane's descendants once; check each child for claude or opencode.
      for cpid in $(ps -eo pid,ppid 2>/dev/null | awk -v p="$pane_pid" '$2==p {print $1}'); do
        # Claude Code: has a session JSON under ~/.claude/sessions/<pid>.json
        if [ -d "$SESSIONS_DIR" ] && [ -f "$SESSIONS_DIR/$cpid.json" ]; then
          cname=""
          if command -v jq &>/dev/null; then
            cname=$(jq -r '.name // empty' "$SESSIONS_DIR/$cpid.json" 2>/dev/null)
          fi
          [ -z "$cname" ] && cname="$win_name"
          claude_names="${claude_names:+$claude_names, }$cname"
          # Grab context stats for this Claude process
          if [ -x "$CLAUDE_CONTEXT_BIN" ]; then
            ctx=$("$CLAUDE_CONTEXT_BIN" "$cpid" 2>/dev/null || true)
            [ -n "$ctx" ] && context_info="$ctx"
          fi
          continue
        fi
        # opencode: detect by process name (no per-session JSON file like claude has).
        # The TUI binary is `opencode` in its argv[0]. Check the command field.
        ccmd=$(ps -p "$cpid" -o command= 2>/dev/null)
        case "$ccmd" in
          *opencode*)
            opencode_found=1
            # Grab context stats for this opencode process
            if [ -x "$OC_CONTEXT_BIN" ]; then
              ctx=$("$OC_CONTEXT_BIN" "$cpid" 2>/dev/null || true)
              [ -n "$ctx" ] && context_info="$ctx"
            fi
            ;;
        esac
      done
    done < <("$TMUX_BIN" list-windows -t "$sess_name" -F "#{window_name} #{pane_pid}" 2>/dev/null)

    # Compose tag — both runtimes can coexist; pick the most specific label.
    # Append context stats (tokens + cost) when available for Claude sessions.
    ctx_suffix=""
    [ -n "$context_info" ] && ctx_suffix="  [$context_info]"
    if [ -n "$claude_names" ] && [ -n "$opencode_found" ]; then
      item="[tmux / claude+opencode] ${claude_names}${ctx_suffix}§${sess_name}"
    elif [ -n "$claude_names" ]; then
      item="[tmux / claude] ${claude_names}${ctx_suffix}§${sess_name}"
    elif [ -n "$opencode_found" ]; then
      item="[tmux / opencode] ${win_names:-$sess_name}${ctx_suffix}§${sess_name}"
    else
      item="[tmux] ${win_names:-$sess_name}§${sess_name}"
    fi
    tmux_items="${tmux_items:+$tmux_items\n}$item"
  done < <("$TMUX_BIN" list-sessions -F "#{session_name}" 2>/dev/null)

  if [ -n "$tmux_items" ]; then
    if [ -n "$choices" ]; then
      choices="$choices\n$tmux_items"
    else
      choices="$tmux_items"
    fi
  fi
fi

# New session options.
# Order matters: fzf's default cursor lands on the first row, so the first
# option here is the one a fresh terminal opens with a single Enter. Andie
# defaults to flowen repl (AVE-aware opencode wrapper) — put it on top.
new_options=""
if [ -n "$TMUX_BIN" ] && command -v flowen >/dev/null 2>&1; then
  new_options="[new] flowen repl (AVE-aware opencode)"
elif [ -n "$TMUX_BIN" ] && command -v opencode >/dev/null 2>&1; then
  # Fallback when flowen wrapper isn't installed but opencode is.
  new_options="[new] opencode (named tmux + opencode)"
fi
[ -n "$TMUX_BIN" ] && new_options="${new_options:+$new_options\n}[new] claude (named tmux + claude)"
new_options="${new_options:+$new_options\n}[new] Ghostty (plain shell)"
[ -n "$TMUX_BIN" ] && new_options="$new_options\n[new] tmux"
[ -n "$ZELLIJ_BIN" ] && new_options="$new_options\n[new] zellij"

if [ -n "$choices" ]; then
  choices="$new_options\n$choices"
else
  choices="$new_options"
fi

# --list-only: just print the refreshed choices for fzf reload, then exit.
if [ "$LIST_ONLY" -eq 1 ]; then
  echo -e "$choices"
  exit 0
fi

# Write choices to a temp file so fzf reload can regenerate the list after kills.
# The regeneration re-runs this script's list-building logic via a helper.
CHOICES_FILE=$(mktemp /tmp/ghostty-picker-XXXXXX)
echo -e "$choices" > "$CHOICES_FILE"
trap 'rm -f "$CHOICES_FILE"' EXIT

# Build the kill+reload command for fzf's --bind.
# fzf passes selected lines via {+f} (file with selected items, one per line).
# We read that file, kill matching tmux sessions, then re-exec the list builder.
KILL_RELOAD_CMD="while IFS= read -r line; do case \"\$line\" in '[new]'*) continue ;; esac; sess=\${line##*§}; [ -z \"\$sess\" ] && continue; att=\$($TMUX_BIN display-message -p '#{session_name}' 2>/dev/null || true); [ \"\$sess\" = \"\$att\" ] && continue; $TMUX_BIN kill-session -t \"\$sess\" 2>/dev/null; done < {+f}; $0 --list-only"

# --list-only: when called with this flag, just print the choices and exit
# (used by fzf reload after kills). Detected at the top of the script below.
# For now, show fzf with the pre-built list.
selected=$(cat "$CHOICES_FILE" | "$FZF_BIN" \
  --height=~50% \
  --layout=reverse \
  --border=rounded \
  --prompt="session > " \
  --header="enter=attach  tab=select  ctrl-x/ctrl-d=kill" \
  --no-info \
  --multi \
  --delimiter='§' \
  --with-nth=1 \
  --bind "ctrl-x:execute-silent($KILL_RELOAD_CMD)+reload($0 --list-only)" \
  --bind "ctrl-d:execute-silent($KILL_RELOAD_CMD)+reload($0 --list-only)" \
  --color=pointer:green,prompt:blue,header:dim) || {
  # If fzf is cancelled (Esc/Ctrl-C), start plain shell
  exec "$SHELL"
}
# In multi-select mode, take only the first selected line for attach/launch
selected=$(echo "$selected" | head -1)

log "selected: $selected"

case "$selected" in
  "[new] Ghostty (plain shell)")
    log "launching plain shell"
    cd_to_last_dir
    exec "$SHELL"
    ;;
  "[new] zellij")
    printf "Session name (empty for default): " > /dev/tty
    read -r session_name < /dev/tty
    cd_to_last_dir
    if [ -z "$session_name" ]; then
      log "launching new zellij (default name)"
      exec "$ZELLIJ_BIN"
    else
      log "launching new zellij: $session_name"
      exec "$ZELLIJ_BIN" -s "$session_name"
    fi
    ;;
  "[new] tmux")
    name="ghostty-$$"
    if "$TMUX_BIN" has-session -t "$name" 2>/dev/null; then
      name="ghostty-$$-$(date +%H%M%S)"
      log "session collision; renamed to $name"
    fi
    log "launching new tmux: $name"
    cd_to_last_dir
    set +e
    "$TMUX_BIN" new-session -s "$name" 2>>"$LOG_FILE"
    rc=$?
    log "tmux new-session exited with code $rc"
    exec "$SHELL"
    ;;
  "[new] claude (named tmux + claude)")
    # One name shared across:
    #   - tmux session name
    #   - tmux window name (→ Ghostty title via set-titles)
    #   - claude session name (via @claude-name tmux option, honored by claude-tmux-sync)
    printf "Session name (empty = auto): " > /dev/tty
    read -r raw_name < /dev/tty
    # Sanitize: tmux session names disallow ':' and '.'; keep it filesystem-safe.
    name=$(printf '%s' "$raw_name" | tr -c 'A-Za-z0-9_-' '-' | sed 's/^-*//;s/-*$//')
    [ -z "$name" ] && name="claude-$$"
    # Collision guard: a duplicate-session error from `tmux new-session` is
    # silently fatal — without this check, the script falls through to send-keys
    # + attach against the EXISTING session, which (if it's running a different
    # runtime) types `claude` into that runtime's prompt. Mirror flowen-start.
    if "$TMUX_BIN" has-session -t "$name" 2>/dev/null; then
      orig_name="$name"
      name="${name}-$(date +%H%M%S)"
      log "session '$orig_name' already exists; renaming to '$name'"
      printf "Session '%s' exists — using '%s' instead.\n" "$orig_name" "$name" > /dev/tty
    fi
    cd_to_last_dir
    log "launching new claude tmux session: $name (raw: $raw_name)"
    set +e
    # Set the @claude-name option BEFORE claude starts so the SessionStart hook
    # (claude-tmux-sync) sees it. Then run claude inside the named session.
    "$TMUX_BIN" new-session -d -s "$name" -n "$name" 2>>"$LOG_FILE"
    "$TMUX_BIN" set-option -t "$name" "@claude-name" "$name" 2>>"$LOG_FILE"
    "$TMUX_BIN" send-keys -t "$name" "claude --model claude-opus-4-6" Enter 2>>"$LOG_FILE"
    "$TMUX_BIN" attach-session -t "$name" 2>>"$LOG_FILE"
    rc=$?
    log "tmux new claude-session exited with code $rc"
    exec "$SHELL"
    ;;
  "[new] flowen repl (AVE-aware opencode)"|"[new] opencode (named tmux + opencode)")
    # Mirror of the claude flow: one name spanning tmux session + window + the
    # @opencode-name user option. Default launcher is `flowen repl` (the
    # AVE-aware opencode wrapper that reads ~/.flowen/state.toml + agent.toml
    # for venture-specific context overlay). Fallback to raw `opencode --agent flowen`
    # when the flowen CLI isn't on PATH (covers fresh-machine bootstrap before
    # flowen-poc is uv-installed).
    if command -v flowen >/dev/null 2>&1; then
      launcher="flowen repl"
    else
      launcher="opencode --agent ${OPENCODE_AGENT:-flowen}"
    fi
    printf "Session name (empty = auto): " > /dev/tty
    read -r raw_name < /dev/tty
    name=$(printf '%s' "$raw_name" | tr -c 'A-Za-z0-9_-' '-' | sed 's/^-*//;s/-*$//')
    [ -z "$name" ] && name="flowen-$$"
    # Collision guard — see claude branch for the why. Critical here: if a
    # claude-running session already owns this name, attaching + send-keys would
    # type `flowen repl` straight into the claude TUI's prompt.
    if "$TMUX_BIN" has-session -t "$name" 2>/dev/null; then
      orig_name="$name"
      name="${name}-$(date +%H%M%S)"
      log "session '$orig_name' already exists; renaming to '$name'"
      printf "Session '%s' exists — using '%s' instead.\n" "$orig_name" "$name" > /dev/tty
    fi
    cd_to_last_dir
    log "launching new opencode tmux session: $name (raw: $raw_name, launcher: $launcher)"
    set +e
    "$TMUX_BIN" new-session -d -s "$name" -n "$name" 2>>"$LOG_FILE"
    "$TMUX_BIN" set-option -t "$name" "@opencode-name" "$name" 2>>"$LOG_FILE"
    "$TMUX_BIN" send-keys -t "$name" "$launcher" Enter 2>>"$LOG_FILE"
    "$TMUX_BIN" attach-session -t "$name" 2>>"$LOG_FILE"
    rc=$?
    log "tmux new opencode-session exited with code $rc"
    exec "$SHELL"
    ;;
  "[tmux / claude]"*|"[tmux / opencode]"*|"[tmux / claude+opencode]"*)
    # All "agent-tagged" tmux sessions attach the same way — the tag is just a
    # display hint for the picker. Session name comes after the § delimiter.
    session_name="${selected##*§}"
    log "attaching tmux (agent-tagged): $session_name"
    set +e
    "$TMUX_BIN" attach-session -t "$session_name" 2>>"$LOG_FILE"
    rc=$?
    log "tmux attach exited with code $rc"
    exec "$SHELL"
    ;;
  \[tmux\]\ *)
    # Extract session name after § delimiter
    session_name="${selected##*§}"
    log "attaching tmux: $session_name"
    set +e
    "$TMUX_BIN" attach-session -t "$session_name" 2>>"$LOG_FILE"
    rc=$?
    log "tmux attach exited with code $rc"
    exec "$SHELL"
    ;;
  \[zellij\]\ *)
    session_name="${selected#\[zellij\] }"
    log "attaching zellij: $session_name"
    exec "$ZELLIJ_BIN" attach "$session_name"
    ;;
  *)
    log "unknown selection: $selected"
    exec "$SHELL"
    ;;
esac
