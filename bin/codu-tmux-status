#!/usr/bin/env bash
# codu-tmux-status: emit tmux status-left and status-right content.
# Called by tmux status-interval (every 5s) via shell-command in tmux.conf.
#
# Left:  AVE badge + session name
# Right: codu builder/claude context tokens + cost + model
#
# Usage:
#   codu-tmux-status left    → AVE + session
#   codu-tmux-status right   → context info for current pane's agent session

set -euo pipefail
export PATH="$HOME/.local/bin:/opt/homebrew/bin:$PATH"

SIDE="${1:-left}"
STATE_FILE="$HOME/.flowen/state.toml"
CODU_DB="$HOME/.local/share/opencode/opencode.db"
CLAUDE_SESSIONS="$HOME/.claude/sessions"
CLAUDE_PROJECTS="$HOME/.claude/projects"

# --- LEFT: AVE badge + session name ---
if [ "$SIDE" = "left" ]; then
  # Read active AVE
  ave=""
  if [ -f "$STATE_FILE" ]; then
    ave=$(sed -n 's/^active_ave *= *"\([^"]*\)".*/\1/p' "$STATE_FILE" 2>/dev/null || true)
  fi
  [ -z "$ave" ] && ave="—"
  ave_upper=$(echo "$ave" | tr '[:lower:]' '[:upper:]')

  sess_name=""
  plan_name=""
  if [ -n "${TMUX:-}" ]; then
    sess_name=$(tmux display-message -p '#{session_name}' 2>/dev/null || true)
    plan_name=$(tmux show-options -v "@codu-plan" 2>/dev/null || true)
  fi

  # AVE in pink, session in purple, plan in dim
  if [ -n "$plan_name" ]; then
    echo "#[fg=#ff1493,bold]${ave_upper}#[fg=#414550] │ #[fg=#bf00ff,bold]${sess_name:-shell}#[fg=#414550] │ #[fg=#aaaaaa]${plan_name}#[default]"
  else
    echo "#[fg=#ff1493,bold]${ave_upper}#[fg=#414550] │ #[fg=#bf00ff,bold]${sess_name:-shell}#[default]"
  fi
  exit 0
fi

# --- RIGHT: agent context for current pane ---
if [ "$SIDE" = "right" ]; then
  [ -z "${TMUX:-}" ] && exit 0

  # Update session state file (piggyback on 5s status refresh)
  "$HOME/.local/bin/codu-session-track" snapshot 2>/dev/null &

  pane_pid=$(tmux display-message -p '#{pane_pid}' 2>/dev/null) || exit 0

  # Walk children of pane to find agent process
  agent_type=""
  agent_pid=""

  for cpid in $(ps -eo pid,ppid 2>/dev/null | awk -v p="$pane_pid" '$2==p {print $1}'); do
    cmd=$(ps -p "$cpid" -o command= 2>/dev/null || true)
    case "$cmd" in
      *opencode*)
        agent_type="codu"
        agent_pid="$cpid"
        break
        ;;
    esac
    # Check for Claude Code
    if [ -f "$CLAUDE_SESSIONS/$cpid.json" ]; then
      agent_type="claude"
      agent_pid="$cpid"
      break
    fi
  done

  # No agent found in this pane
  if [ -z "$agent_type" ]; then
    echo ""
    exit 0
  fi

  # --- Claude Code: use PID helper ---
  if [ "$agent_type" = "claude" ]; then
    ctx=$("$HOME/.local/bin/claude-context-for-pid" "$agent_pid" 2>/dev/null || true)
    if [ -n "$ctx" ]; then
      echo "#[fg=#87ceeb]$ctx#[default] "
    fi
    exit 0
  fi

  # --- codu builder: use PID helper (matches via -s flag or process start time) ---
  if [ "$agent_type" = "codu" ]; then
    ctx=$("$HOME/.local/bin/codu-context-for-pid" "$agent_pid" 2>/dev/null || true)
    if [ -n "$ctx" ]; then
      echo "#[fg=#87ceeb]${ctx}#[default] "
    fi
    exit 0
  fi

  exit 0
fi
