#!/bin/bash
# set -x
# set -e

DOTFILES_ROOT="`pwd`"

echo "Install"

main () {
  submodules
  symlinks
  xdg_configs
  bin_scripts
  platform
  generic
}

submodules () {
  echo "Initialising submodules"
  git submodule init && git submodule update
}

xdg_configs () {
  echo "Symlinking XDG config dirs"
  mkdir -p "$HOME/.config"

  # ghostty/ → ~/.config/ghostty/
  if [ -d "$DOTFILES_ROOT/ghostty" ]; then
    rm -rf "$HOME/.config/ghostty"
    ln -s "$DOTFILES_ROOT/ghostty" "$HOME/.config/ghostty"
    success "Linked ghostty → ~/.config/ghostty"
  fi

  # tmux/ → ~/.config/tmux/
  if [ -d "$DOTFILES_ROOT/tmux" ]; then
    rm -rf "$HOME/.config/tmux"
    ln -s "$DOTFILES_ROOT/tmux" "$HOME/.config/tmux"
    success "Linked tmux → ~/.config/tmux"
  fi
}

bin_scripts () {
  echo "Symlinking bin scripts"
  mkdir -p "$HOME/.local/bin"

  if [ -f "$DOTFILES_ROOT/bin/ghostty-session-picker" ]; then
    ln -sf "$DOTFILES_ROOT/bin/ghostty-session-picker" "$HOME/.local/bin/ghostty-session-picker"
    success "Linked ghostty-session-picker → ~/.local/bin/"
  fi

  if [ -f "$DOTFILES_ROOT/bin/claude-tmux-sync" ]; then
    ln -sf "$DOTFILES_ROOT/bin/claude-tmux-sync" "$HOME/.local/bin/claude-tmux-sync"
    success "Linked claude-tmux-sync → ~/.local/bin/"
  fi

  if [ -f "$DOTFILES_ROOT/bin/aerospace-monitor-layout" ]; then
    ln -sf "$DOTFILES_ROOT/bin/aerospace-monitor-layout" "$HOME/.local/bin/aerospace-monitor-layout"
    success "Linked aerospace-monitor-layout → ~/.local/bin/"
  fi
}

platform () {
  platform="unknown"
  if [[ "$(uname)" == "Darwin" ]]; then
     platform="macos"
  elif [[ "$(expr substr $(uname -s) 1 5)" == "Linux" ]]; then
     platform="linux"
  elif [[ "$(expr substr $(uname -s) 1 10)" == "MINGW32_NT" ]]; then
      platform="windows"
  fi

  echo "Running installers for $platform"

  find . -name $platform.sh |\
    while read installer ; do echo $installer && sh "${installer}"; done
}

generic () {
  echo "Running generic installers"

  find . -name all.sh |\
    while read installer ; do sh -c "${installer}" > /dev/null ; done
}

symlinks () {
  echo "Create symlinks"

  overwrite_all=false
  backup_all=false
  skip_all=false

  for source in `find $DOTFILES_ROOT -maxdepth 2 -name \*.symlink`; do
    dest="$HOME/.`basename \"${source%.*}\"`"

    if [ -f $dest ] || [ -d $dest ]; then

      overwrite=false
      backup=false
      skip=false

      if [ "$overwrite_all" == "false" ] && [ "$backup_all" == "false" ] && [ "$skip_all" == "false" ]; then
          user "File already exists: `basename $source`, what do? [s]kip, [S]kip all, [o]verwrite, Overwrite [a]ll, [b]ackup, [B]ackup all?"
          read -n 1 action

          case "$action" in
            o )
              overwrite=true;;
            a )
              overwrite_all=true;;
            b )
              backup=true;;
            B )
              backup_all=true;;
            s )
              skip=true;;
            S )
              skip_all=true;;
            * )
              ;;
          esac
        fi

        if [ "$overwrite" == "true" ] || [ "$overwrite_all" == "true" ]; then
          rm -rf $dest
          success "removed $dest"
        fi

        if [ "$backup" == "true" ] || [ "$backup_all" == "true" ]; then
          mv $dest $dest\.backup
          success "moved $dest to $dest.backup"
        fi

        if [ "$skip" == "false" ] && [ "$skip_all" == "false" ]; then
          link_files $source $dest
        else
          success "skipped $source"
        fi
      else
        link_files $source $dest
      fi
  done
}

info () {
  printf "  [ \033[00;34m..\033[0m ] $1"
}
user () {
  printf "\r  [ \033[0;33m?\033[0m ] $1 "
}
success () {
  printf "\r\033[2K  [ \033[00;32mOK\033[0m ] $1\n"
}
fail () {
  printf "\r\033[2K  [\033[0;31mFAIL\033[0m] $1\n"
  echo ''
  exit
}

link_files () {
  ln -s $1 $2
  success "Linked $1 to $2"
}

main

# vim: fdm=indent foldlevel=0
